<!doctype html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Kartu Stock</title><link rel="stylesheet" href="/css/bootstrap.min.css"><link rel="stylesheet" href="/css/inventory.css"></head><body><div id="inventoryContext"></div><div class="container-fluid p-3 p-lg-4"><div class="d-flex justify-content-between mb-4"><div><div class="eyebrow">STOCK MOVEMENT</div><h2 class="fw-bold">Kartu Stock</h2><div class="text-secondary">Riwayat movement append-only dengan saldo kronologis.</div></div><a href="/inventory" class="btn btn-outline-secondary">← Inventory</a></div><div class="card border-0 shadow-sm"><div class="card-body"><div class="row g-2 mb-3"><div class="col-md-4"><input id="prdid" class="form-control" placeholder="Kode produk (opsional)"></div><div class="col-md-3"><input id="from" type="date" class="form-control"></div><div class="col-md-3"><input id="to" type="date" class="form-control"></div><div class="col-md-2"><button id="filter" class="btn btn-primary w-100">Tampilkan</button></div></div><div class="table-responsive"><table class="table table-hover table-sm"><thead><tr><th>Tanggal</th><th>Ref</th><th>Produk</th><th>Batch</th><th>Tipe</th><th class="text-end">IN</th><th class="text-end">OUT</th><th class="text-end">Saldo</th></tr></thead><tbody id="rows"></tbody></table></div></div></div></div><script src="/js/inventory-movement.js"></script><script src="/js/inventory-context.js"></script></body></html>