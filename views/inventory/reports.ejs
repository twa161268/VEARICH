<!doctype html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Laporan Inventory</title><link rel="stylesheet" href="/css/bootstrap.min.css"><link rel="stylesheet" href="/css/inventory.css"></head><body><div id="inventoryContext"></div><div class="container-fluid p-3 p-lg-4"><div class="d-flex justify-content-between mb-4"><div><div class="eyebrow">REPORT</div><h2 class="fw-bold">Laporan Inventory</h2><div class="text-secondary">Laporan berbasis stock movement dan saldo kronologis.</div></div><a href="/inventory" class="btn btn-outline-secondary">← Inventory</a></div><div class="card border-0 shadow-sm"><div class="card-body"><div class="row g-2 mb-3"><div class="col-md-3"><select id="tipe" class="form-select"><option value="">Semua Movement</option><option>PEMBELIAN</option><option>PENGELUARAN</option><option>RETUR_BELI</option><option>RETUR_JUAL</option><option>TRANSFER_IN</option><option>TRANSFER_OUT</option><option>ADJUSTMENT</option><option>OPNAME</option><option>PENJUALAN</option></select></div><div class="col-md-3"><input id="prdid" class="form-control" placeholder="Kode produk"></div><div class="col-md-2"><input id="from" type="date" class="form-control"></div><div class="col-md-2"><input id="to" type="date" class="form-control"></div><div class="col-md-2"><button id="go" class="btn btn-primary w-100">Tampilkan</button></div></div><div class="table-responsive"><table class="table table-sm"><thead><tr><th>Tanggal</th><th>Ref</th><th>Produk</th><th>Gudang</th><th>Tipe</th><th class="text-end">IN</th><th class="text-end">OUT</th><th class="text-end">Saldo</th></tr></thead><tbody id="rows"></tbody></table></div></div></div></div><script src="/js/inventory-reports.js"></script><script src="/js/inventory-context.js"></script></body></html>