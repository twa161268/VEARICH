<!doctype html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Stock Balance</title><link rel="stylesheet" href="/css/bootstrap.min.css"><link rel="stylesheet" href="/css/inventory.css"></head><body><div id="inventoryContext"></div><div class="container-fluid p-3 p-lg-4"><div class="d-flex justify-content-between mb-4"><div><div class="eyebrow">STOCK</div><h2 class="fw-bold">Stock Balance</h2><div class="text-secondary">Saldo stok berjalan pada gudang stockist login.</div></div><a href="/inventory" class="btn btn-outline-secondary">← Inventory</a></div><div class="card border-0 shadow-sm"><div class="card-body"><input id="search" class="form-control mb-3" style="max-width:450px" placeholder="Produk / barcode / batch"><div class="table-responsive"><table class="table table-hover"><thead><tr><th>Produk</th><th>Barcode</th><th>Batch</th><th>Expired</th><th>Satuan</th><th class="text-end">Qty</th><th>Minimum</th></tr></thead><tbody id="rows"></tbody></table></div><div class="d-flex justify-content-between"><button id="prev" class="btn btn-sm btn-outline-secondary">←</button><span id="info"></span><button id="next" class="btn btn-sm btn-outline-secondary">→</button></div></div></div></div><script src="/js/inventory-stock.js"></script><script src="/js/inventory-context.js"></script></body></html>