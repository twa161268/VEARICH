<!doctype html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%=title%></title><link rel="stylesheet" href="/css/bootstrap.min.css"><link rel="stylesheet" href="/icons/bootstrap-icons.css"><link rel="stylesheet" href="/css/inventory.css"></head><body>
<div id="inventoryContext"></div><div class="container-fluid p-3 p-lg-4"><div class="d-flex justify-content-between align-items-center mb-4"><div><div class="eyebrow">INVENTORY TRANSACTION</div><h2 class="fw-bold mb-1"><%=title%></h2><div class="text-secondary">Gudang ditentukan server berdasarkan stockist login.</div></div><div class="d-flex gap-2"><a href="/inventory" class="btn btn-outline-secondary">← Inventory</a><button id="add" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Baru</button></div></div>
<div class="card border-0 shadow-sm mb-3"><div class="card-body"><div class="row g-2"><div class="col-md-4"><input id="search" class="form-control" placeholder="Cari nomor transaksi"></div><div class="col-auto"><button id="refresh" class="btn btn-outline-primary">Refresh</button></div></div></div></div>
<div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>No</th><th>Tanggal</th><th>Status</th><th>Info</th><th class="text-end">Aksi</th></tr></thead><tbody id="rows"></tbody></table></div><div class="card-footer bg-white d-flex justify-content-between align-items-center"><button id="prev" class="btn btn-sm btn-outline-secondary">←</button><span id="info"></span><button id="next" class="btn btn-sm btn-outline-secondary">→</button></div></div></div>
<div class="modal fade" id="modal" tabindex="-1"><div class="modal-dialog modal-xl modal-dialog-scrollable"><div class="modal-content"><div class="modal-header"><h5 id="modalTitle">Transaksi</h5><button class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><form id="form"><input type="hidden" id="id"><div class="row g-3 mb-3">
<div class="col-md-4" id="stockistWrap"><label class="form-label">Stockist</label><% if (isAdmin) { %><select id="stkid" class="form-select"><option value="">- pilih stockist -</option><% stockists.forEach(s => { %><option value="<%= s.stkid %>"><%= s.stkid %> - <%= s.namastk || '' %></option><% }) %></select><% } else { %><input id="stkid" class="form-control bg-light" value="<%= sessionStkid || '' %>" readonly><% } %></div>
<div class="col-md-3"><label class="form-label">Tanggal</label><input id="tanggal" type="datetime-local" class="form-control" required></div><div class="col-md-4" id="supplierWrap"><label class="form-label">Supplier</label><select id="supplier_id" class="form-select"><option value="">- pilih -</option></select></div><div class="col-md-4" id="destWrap"><label class="form-label">Gudang Tujuan</label><select id="gudang_tujuan_id" class="form-select"><option value="">- pilih -</option></select></div><div class="col-md-4" id="orderWrap"><label class="form-label">Order No (opsional)</label><input id="orderno" class="form-control"></div><div class="col-md-8"><label class="form-label">Keterangan</label><input id="keterangan" class="form-control"></div></div>
<div class="table-responsive"><table class="table table-sm align-middle" id="detailTable"><thead id="dhead"></thead><tbody id="details"></tbody></table></div><button type="button" id="addLine" class="btn btn-sm btn-outline-primary">+ Tambah Item</button></form></div><div class="modal-footer"><span id="msg" class="me-auto text-danger"></span><button class="btn btn-secondary" data-bs-dismiss="modal">Tutup</button><button class="btn btn-primary" id="save">Simpan DRAFT</button></div></div></div></div>
<script>window.INV_TX_TYPE='<%=type%>';window.INV_IS_ADMIN=<%= isAdmin ? 'true':'false' %>;window.INV_SELECTED_STKID=<%- JSON.stringify(selectedStkid || '') %>;window.INV_SESSION_STKID=<%- JSON.stringify(sessionStkid || '') %>;</script><script src="/js/bootstrap.bundle.min.js"></script><script src="/js/inventory-transaction.js"></script><script src="/js/inventory-context.js"></script></body></html>