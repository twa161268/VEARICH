<!DOCTYPE html>
<html lang="id"><head><meta charset="UTF-8"><title>Nota <%= data.header.registerno %></title><style>body{font-family:Arial,sans-serif;font-size:12px;color:#111}.head{text-align:center;margin-bottom:15px}.head h2{margin:0;font-size:18px}.head div{margin-top:4px}.meta{width:100%;margin-bottom:12px}.meta td{padding:2px 4px;vertical-align:top}.table{width:100%;border-collapse:collapse;margin-top:8px}.table th,.table td{border:1px solid #aaa;padding:5px}.table th{background:#eee}.right{text-align:right}.total{font-weight:bold}.section{font-weight:bold;margin-top:14px;margin-bottom:5px}.note{margin-top:18px;font-size:10px;color:#555}</style></head><body>
<div class="head"><h2><%= company %></h2><div>NOTA PEMBAYARAN & PENGIRIMAN</div><div><strong><%= data.header.registerno %></strong></div></div>
<table class="meta"><tr><td width="18%">Tanggal</td><td width="32%">: <%= data.header.createdt ? new Date(data.header.createdt).toLocaleString('id-ID') : '-' %></td><td width="18%">Kirim</td><td>: <%= data.header.kirim ? 'Ya' : 'Tidak' %></td></tr><tr><td>Nama Kirim</td><td>: <%= data.header.namakirim || '-' %></td><td>Stockist</td><td>: <%= data.header.stkid || '-' %></td></tr><tr><td>Alamat</td><td colspan="3">: <%= data.header.alamat || '-' %>, <%= data.header.kelurahan || '-' %>, <%= data.header.kecamatan || '-' %>, <%= data.header.wilayah || '-' %>, <%= data.header.kota || '-' %> <%= data.header.kodepos || '' %></td></tr></table>
<div class="section">TRANSAKSI PIN</div><table class="table"><thead><tr><th>Order No</th><th>Nama</th><th class="right">Total Harga</th><th class="right">PIN</th><th class="right">BV</th></tr></thead><tbody><% data.transactions.forEach(r => { %><tr><td><%= r.orderno %></td><td><%= r.nama || '-' %></td><td class="right">Rp <%= Number(r.total_harga||0).toLocaleString('id-ID') %></td><td class="right"><%= Number(r.total_pin||0).toLocaleString('id-ID') %></td><td class="right"><%= Number(r.total_bv||0).toLocaleString('id-ID') %></td></tr><% }) %></tbody></table>
<table class="table"><tr><td>Total Barang</td><td class="right">Rp <%= Number(data.transactions.reduce((s,r)=>s+Number(r.total_harga||0),0)).toLocaleString('id-ID') %></td></tr><tr><td>Ongkos Kirim</td><td class="right">Rp <%= Number(data.header.ongkir||0).toLocaleString('id-ID') %></td></tr><tr class="total"><td>TOTAL TAGIHAN</td><td class="right">Rp <%= Number(data.header.bayar||0).toLocaleString('id-ID') %></td></tr></table>
<div class="section">PEMBAYARAN</div><table class="table"><thead><tr><th>Paytype</th><th>Deskripsi</th><th class="right">Amount</th><th>Catatan</th></tr></thead><tbody><% data.payments.forEach(p => { %><tr><td><%= p.paytype %></td><td><%= p.deskripsi || '-' %></td><td class="right">Rp <%= Number(p.amount||0).toLocaleString('id-ID') %></td><td><%= p.catatan || '-' %></td></tr><% }) %></tbody></table>
<div style="margin-top:8px;text-align:right;font-weight:bold">TOTAL PEMBAYARAN: Rp <%= Number(data.payments.reduce((s,r)=>s+Number(r.amount||0),0)).toLocaleString('id-ID') %></div>
<div class="note">Nota ini merupakan bukti pembayaran dan pengiriman untuk register <%= data.header.registerno %>.</div>
</body></html>
