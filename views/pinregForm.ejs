<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= edit ? 'Edit' : 'Tambah' %> Transaksi PIN</title>
    <link rel="stylesheet" href="/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/icons/bootstrap-icons.css" />
    <link rel="stylesheet" href="/css/pinreg.css" />
  </head>
  <body class="bg-light">
    <div class="container-fluid px-3 px-lg-4 py-4">
      <div
        class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4"
      >
        <div>
          <div class="pin-eyebrow">TRANSACTION CENTER</div>
          <h2 class="fw-bold mb-1">
            <%= edit ? 'Edit' : 'Tambah' %> Transaksi Pembelian PIN
          </h2>
          <div class="text-secondary">
            Header dan detail produk disimpan sebagai satu transaksi.
          </div>
        </div>
        <a href="/pinreg" class="btn btn-outline-secondary"
          ><i class="bi bi-arrow-left me-1"></i> Kembali</a
        >
      </div>

      <form id="pinregForm">
        <div class="card border-0 shadow-sm pin-card mb-3">
          <div
            class="card-header bg-white border-0 p-3 p-lg-4 d-flex justify-content-between align-items-center"
          >
            <div>
              <h5 class="fw-bold mb-1">Informasi Transaksi</h5>
              <small class="text-secondary"
                >Order No dibuat otomatis saat transaksi baru disimpan.</small
              >
            </div>
            <div class="text-end">
              <small class="text-secondary d-block">ORDER NO</small
              ><strong id="orderPreview" class="text-primary"
                ><%= edit ? orderno : 'OTOMATIS' %></strong
              >
            </div>
          </div>
          <div class="card-body p-3 p-lg-4">
            <div class="row g-3">
              <div class="col-md-6">
                <label class="form-label fw-semibold"
                  >Nama <span class="text-danger">*</span></label
                ><input
                  id="nama"
                  maxlength="30"
                  class="form-control"
                  required
                />
              </div>
              <div class="col-md-6">
                <label class="form-label fw-semibold">No HP</label
                ><input id="nohp" maxlength="25" class="form-control" />
              </div>
              <div class="col-md-6">
                <label class="form-label fw-semibold">Username Sponsor</label
                ><input id="usernamesp" maxlength="30" class="form-control" />
              </div>
              <div class="col-md-6">
                <label class="form-label fw-semibold">Nama Sponsor</label
                ><input id="namasp" maxlength="50" class="form-control" />
              </div>

              <div class="col-md-6">
                <label class="form-label fw-semibold">Stockist ID</label>
                <div class="form-control bg-light">
                  <strong><%= stkid || '-' %></strong>
                </div>
                <small class="text-muted">
                  Stockist sesuai yang sedang login.
                </small>
              </div>

              <div class="col-md-6">
                <label class="form-label fw-semibold">Register No</label>

                <div class="form-control bg-light text-muted">
                  tidak diisi sekarang
                </div>

                <small class="text-muted">
                  Akan diberikan pada proses berikutnya.
                </small>
                <input type="hidden" id="registerno" />

                <!--<input
                  id="registerno"
                  maxlength="10"
                  class="form-control"
                  placeholder="tidak untuk diisi sekarang, nanti lewat proses"
                />-->
              </div>
            </div>
          </div>
        </div>

        <div class="card border-0 shadow-sm pin-card">
          <div
            class="card-header bg-white border-0 p-3 p-lg-4 d-flex flex-wrap justify-content-between align-items-center gap-2"
          >
            <div>
              <h5 class="fw-bold mb-1">Produk Transaksi</h5>
              <small class="text-secondary"
                >Price Code sementara dikunci ke
                <strong><%= pricecode %></strong>.</small
              >
            </div>
            <button type="button" id="btnTambahProduk" class="btn btn-primary">
              <i class="bi bi-plus-lg me-1"></i> Tambah Produk
            </button>
          </div>
          <div class="card-body p-2 p-lg-3"><div id="detailRows"></div></div>
          <div class="px-3 pb-3">
            <div class="pin-total-box">
              <div>
                <small>Total Harga</small><strong id="totalHarga">Rp 0</strong>
              </div>
              <div>
                <small>Total PIN</small><strong id="totalPin">0</strong>
              </div>
              <div><small>Total BV</small><strong id="totalBv">0</strong></div>
            </div>
          </div>
        </div>

        <div class="d-flex justify-content-end gap-2 mt-3">
          <a href="/pinreg" class="btn btn-outline-secondary">Batal</a
          ><button id="btnSimpan" class="btn btn-primary px-4">
            <i class="bi bi-check2-circle me-1"></i> Simpan Transaksi
          </button>
        </div>
      </form>
    </div>
    <div class="toast-container position-fixed bottom-0 end-0 p-3">
      <div id="pinToast" class="toast"><div class="toast-body"></div></div>
    </div>
    <script>
      window.PINREG_EDIT=<%= edit ? 'true' : 'false' %>;window.PINREG_ORDERNO=<%- JSON.stringify(orderno || '') %>;window.PINREG_PRICECODE='<%= pricecode %>';
    </script>
    <script src="/js/bootstrap.bundle.min.js"></script>
    <script src="/js/pinregForm.js"></script>
  </body>
</html>
