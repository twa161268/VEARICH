<!DOCTYPE html>
<html>
<head>
    <title>Ref Nilai</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">

<div class="container mt-5" style="max-width: 500px;">
    <h4 class="mb-4">Parameter Penilaian</h4>

    <form id="formRef">

        <div class="row mb-2">
            <div class="col-6">Nilai Bonus</div>
            <div class="col-6"><input name="nilaibonus" class="form-control"></div>
        </div>

        <div class="row mb-2">
            <div class="col-6">Cuti Sakit</div>
            <div class="col-6"><input name="cutisakita" class="form-control"></div>
        </div>

        <div class="row mb-2">
            <div class="col-6">Telat > 30 Menit</div>
            <div class="col-6"><input name="telatu30a" class="form-control"></div>
        </div>

        <div class="row mb-2">
            <div class="col-6">Telat < 30 Menit</div>
            <div class="col-6"><input name="telatd30a" class="form-control"></div>
        </div>

        <div class="row mb-2">
            <div class="col-6">Telat > 60 Menit</div>
            <div class="col-6"><input name="telatu60a" class="form-control"></div>
        </div>

        <div class="row mb-2">
            <div class="col-6">Lupa Absen</div>
            <div class="col-6"><input name="lupaa" class="form-control"></div>
        </div>

        <div class="row mb-2">
            <div class="col-6">Hadir Full</div>
            <div class="col-6"><input name="hadirfulla" class="form-control"></div>
        </div>

        <div class="row mb-2">
            <div class="col-6">Ontime</div>
            <div class="col-6"><input name="ontimea" class="form-control"></div>
        </div>

        <div class="row mb-2">
            <div class="col-6">Overtime</div>
            <div class="col-6"><input name="ovrmnta" class="form-control"></div>
        </div>

        <div class="row mb-2">
            <div class="col-6">Kerja Hari Libur</div>
            <div class="col-6"><input name="kerjalibura" class="form-control"></div>
        </div>

        <div class="row mb-2">
            <div class="col-6">Lalai</div>
            <div class="col-6"><input name="lalaia" class="form-control"></div>
        </div>

        <div class="row mb-2">
            <div class="col-6">Tunda Pekerjaan</div>
            <div class="col-6"><input name="tundaa" class="form-control"></div>
        </div>

        <div class="row mb-3">
            <div class="col-6">Alpha</div>
            <div class="col-6"><input name="alphaa" class="form-control"></div>
        </div>

        <button type="submit" class="btn btn-primary w-100">Simpan</button>
    </form>
</div>

<script src="/js/reffnilai.js"></script>

</body>
</html>