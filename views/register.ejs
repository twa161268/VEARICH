<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Registrasi Member</title>
  <link rel="stylesheet" href="/css/bootstrap.min.css" />
  <link rel="stylesheet" href="/icons/bootstrap-icons.css" />
  <link rel="stylesheet" href="/css/register.css" />
</head>
<body class="bg-light">
  <div class="container-fluid px-3 px-lg-4 py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
      <div>
        <div class="reg-eyebrow">MEMBER REGISTRATION</div>
        <h2 class="fw-bold mb-1">Registrasi Member Menggunakan PIN</h2>
        <div class="text-secondary">
          Pilih Register No dari transaksi PIN yang sudah dibeli.
        </div>
      </div>
      <a href="/" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Kembali
      </a>
    </div>

    <div class="card border-0 shadow-sm reg-card">
      <div class="card-header bg-white border-0 p-3 p-lg-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
          <div>
            <h5 class="fw-bold mb-1">Daftar Register</h5>
            <small class="text-secondary">
              Jml PIN berasal dari <strong>tr_kirim.tpin</strong>.
            </small>
          </div>
          <div class="input-group reg-search">
            <span class="input-group-text bg-light border-end-0">
              <i class="bi bi-search"></i>
            </span>
            <input id="search" class="form-control bg-light border-start-0"
                   placeholder="Cari register / nama kirim..." />
          </div>
        </div>
      </div>

      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead>
            <tr>
              <th>Register No</th>
              <th>Nama Kirim</th>
              <th class="text-end">PIN Dibeli</th>
              <th class="text-end">PIN Terpakai</th>
              <th class="text-end">PIN Sisa</th>
              <th>Stockist</th>
              <th>Tanggal</th>
              <th class="text-center">Aksi</th>
            </tr>
          </thead>
          <tbody id="rows">
            <tr>
              <td colspan="8" class="text-center py-5 text-secondary">
                Memuat data...
              </td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="card-footer bg-white border-0 d-flex justify-content-center align-items-center gap-3 py-3">
        <button id="prev" class="btn btn-sm btn-outline-secondary">← Sebelumnya</button>
        <span id="pageInfo" class="small text-secondary"></span>
        <button id="next" class="btn btn-sm btn-outline-secondary">Berikutnya →</button>
      </div>
    </div>
  </div>

  <script>
    window.REGISTER_PRICECODE = <%- JSON.stringify(pricecode) %>;
  </script>
  <script src="/js/bootstrap.bundle.min.js"></script>
  <script src="/js/register.js"></script>
</body>
</html>
